# UP Police Data Analyst — environment
# Copy to .env and fill in your local values.
# .env is gitignored — never commit real secrets.

# --- Database (Postgres; Phase 1 does NOT use SQLite anymore) ---
AGENT_DATABASE_URL=postgresql://analyst:***@localhost:5432/up_police_analyst

# --- LLM provider selection ---
# Set exactly one provider block below.
# Option A: Ollama (air-gapped / on-prem)
AGENT_LLM_PROVIDER=auto
AGENT_LLM_MODEL=
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_OLLAMA_MODEL=llama3.1:8b-instruct-q4_0

# Option B: NVIDIA NIM (OpenAI-compatible cloud LLM)
# AGENT_LLM_PROVIDER=nvidia
# AGENT_LLM_MODEL=meta/llama-3.3-70b-instruct
# AGENT_NVIDIA_API_KEY=nvapi-...
# AGENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AGENT_NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# kept for harness compatibility only — ignored by the project-wide provider logic
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=
AGENT_OPENROUTER_API_KEY=

# --- Token budget ---
AGENT_TOKEN_BUDGET=8192

# --- MSSQL (Phase 2+; leave blank in Phase 1) ---
# AGENT_MSSQL_CONNECTION_STRING=mssql+pyodbc://user:pass@mssql-host:1433/PoliceDB?driver=ODBC+Driver+17+for+SQL+Server
# MSSQL_INGEST_ENABLED=false

# --- Server ---
PORT=8001
AGENT_LOG_LEVEL=INFO
